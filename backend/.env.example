NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/doablinkorbit
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7
CLIENT_URL=http://localhost:5173
SEED_DEMO=true
TRUST_PROXY=false
DISABLE_JOBS=false
SERVE_FRONTEND=false
# Optional. Leave blank until Firebase Cloud Messaging is configured.
# FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional private recording storage. Playback stays off until these are set
# and @aws-sdk/client-s3 plus @aws-sdk/s3-request-presigner are installed.
# RECORDING_S3_BUCKET=
# RECORDING_S3_REGION=
# RECORDING_S3_ENDPOINT=
# RECORDING_S3_ACCESS_KEY=
# RECORDING_S3_SECRET=
# RECORDING_URL_SECONDS=300
# Optional folder for recordings uploaded by the Android app. Defaults to storage/recordings.
# RECORDING_DIR=
